      },
      {
        "pagePath": "pages/question/question",
        "text": "题库",
        "iconPath": "static/tabbar/question.png",
        "selectedIconPath": "static/tabbar/question-active.png"
      },
      {
        "pagePath": "pages/user/user",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
